{
  "expo": {
    "name": "ParkNow",
    "slug": "parknow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parknow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "co.parknow.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "ParkNow usa Face ID para ingresar y confirmar pagos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02368A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.parknow.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#02368A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkNow usa tu ubicación para mostrarte los parqueaderos cercanos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ParkNow usa la cámara para escanear el código QR de las reservas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ParkNow usa Face ID para ingresar y confirmar pagos."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00B4D8"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "ParkNow usa el acelerómetro para actualizar los cupos al agitar el celular."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
